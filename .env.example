# Nukopijuok i ".env" ir uzpildyk - SKIRTA TIK LOKALIAM TESTAVIMUI.
# (GitHub Actions sias reiksmes ima is repozitorijos Secrets, ne is sio failo.)

GRAPH_VERSION=v23.0
ENABLE_IG=true
ENABLE_FB=true

# IG susietas su FB puslapiu -> graph.facebook.com
# IG NESUSIETAS (Instagram Login) -> graph.instagram.com
IG_GRAPH_HOST=graph.facebook.com
IG_USER_ID=
IG_ACCESS_TOKEN=

FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Lokaliam testavimui (kai NESI GitHub Actions) butina nurodyti, kur viesai
# pasiekiami paveiksleliai, pvz. https://raw.githubusercontent.com/tu/repas/main/media
MEDIA_BASE_URL=
